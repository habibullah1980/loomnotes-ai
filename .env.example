# ==============================================================================
# LoomNotes AI — Production & Local Environment Variables
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to .env.local and fill in your values.
# 2. For Vercel production: add these exact variable names in Project Settings -> Environment Variables.
# 3. NEVER commit real secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to browser via NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
# The canonical URL of your deployed application
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Never exposed to browser bundles or client JavaScript)
# ------------------------------------------------------------------------------
# Supabase Privileged Service Role Key (Supabase Dashboard -> Project Settings -> API)
# Used exclusively server-side for admin authentication operations and data management
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google AI Studio API Key (https://aistudio.google.com/)
# Used server-side for transcript summarization and structured JSON extraction
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model identifier (e.g. gemini-2.5-flash or gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT CONFIGURATION (Freemium & Pro $9.99/month Subscription)
# ------------------------------------------------------------------------------
# Stripe Secret Key (Dashboard -> Developers -> API keys -> Secret key)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret (Dashboard -> Developers -> Webhooks -> Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Public Stripe Publishable Key (optional for client-side elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Optional: Stripe Price ID for $9.99/mo plan (if created in Stripe Product Catalog)
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here
